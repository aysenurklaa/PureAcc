# Örnek ortam değişkenleri — gerçek değerleri .env dosyasına koyun (.env git ile izlenmez).
# Java varsayılan olarak .env okumaz; IDE Run Configuration veya -D ile aynı değerleri verin.
#
# Örnek JDBC (SQLite dosya):
#   PUREACC_DB_URL=jdbc:sqlite:C:/projeler/PureAcc-main/data/pureacc.db
#
# Örnek JVM argümanları:
#   -Dpureacc.db.url=jdbc:sqlite:data/pureacc.db
#   -Dpureacc.db.pool.max=12

PUREACC_DB_URL=jdbc:sqlite:data/pureacc.db
